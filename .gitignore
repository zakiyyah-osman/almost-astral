# Node
node_modules/
dist/

# Python
.venv/
__pycache__/
*.pyc

# Raw datasets are too big for Git (keep the folder itself)
data/raw/*
!data/raw/.gitkeep
# Raw downloads saved anywhere else by mistake (for example web/data/raw/). Files over 50 MB cannot
# be ignored by size: python data/validate.py fails if Git could commit one.
web/data/
**/raw/*
!data/raw/.gitkeep

# Secrets
.env
.env.*
!.env.example

# Personal Claude Code settings (the shared .claude/settings.json is committed)
.claude/settings.local.json

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
